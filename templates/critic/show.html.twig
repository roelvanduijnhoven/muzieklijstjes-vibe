{% extends 'base.html.twig' %}
{% import 'macros/rating.html.twig' as rating_macros %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ critic.name }}</li>
      </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-12">
            <h1>{{ critic.name }}</h1>
            
            <div class="mb-3">
                {% for genre in critic.genres %}
                    <span class="badge bg-secondary">{{ genre.name }}</span>
                {% endfor %}
                {% for feature in critic.features %}
                    <span class="badge bg-info text-dark">{{ feature.name }}</span>
                {% endfor %}
            </div>

            <p class="lead text-muted">
                {% if critic.birthYear %}
                    <span class="me-3"><i class="fas fa-star me-1"></i> Geboren: {{ critic.birthYear }}</span>
                {% endif %}
                {% if critic.deathYear %}
                    <span class="me-3"><i class="fas fa-cross me-1"></i> Overleden: {{ critic.deathYear }}</span>
                {% endif %}
            </p>

            <div class="mb-3">
                {% if critic.url %}
                    <a href="{{ critic.url }}" target="_blank" class="btn btn-outline-primary btn-sm me-2">
                        <i class="fas fa-globe me-1"></i> Website
                    </a>
                {% endif %}
                {% if critic.wikipediaUrl %}
                    <a href="{{ critic.wikipediaUrl }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                        <i class="fab fa-wikipedia-w me-1"></i> Wikipedia
                    </a>
                {% endif %}
            </div>

            {% if critic.bio %}
                <div class="card mb-4 bg-light">
                    <div class="card-body">
                        <p class="card-text">{{ critic.bio|nl2br }}</p>
                    </div>
                </div>
            {% endif %}
            
            <p>
                Deze recensent heeft <a href="#lists">{{ critic.albumLists|length }} lijsten</a> en <a href="#reviews">{{ critic.reviews|length }} recensies</a>.
            </p>
        </div>
    </div>

    <hr>

    {% set base_params = {id: critic.id, slug: critic.slug}|merge(app.request.query.all) %}

    <div class="row">
        <div class="col-12">
            <div id="lists" class="mt-4">
                <h3>Lijsten</h3>
                {% if sortedLists is not empty %}
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 100px;">Preview</th>
                                    <th>
                                        {% set next_dir = (listSort == 'title' and listDir == 'asc') ? 'desc' : 'asc' %}
                                        <a href="{{ path('app_critic_show', base_params|merge({'list_sort': 'title', 'list_dir': next_dir})) }}#lists" class="text-dark text-decoration-none">
                                            Lijst
                                            {% if listSort == 'title' %}{{ listDir == 'asc' ? '↑' : '↓' }}{% endif %}
                                        </a>
                                    </th>
                                    <th>
                                        {% set next_dir = (listSort == 'type' and listDir == 'asc') ? 'desc' : 'asc' %}
                                        <a href="{{ path('app_critic_show', base_params|merge({'list_sort': 'type', 'list_dir': next_dir})) }}#lists" class="text-dark text-decoration-none">
                                            Type
                                            {% if listSort == 'type' %}{{ listDir == 'asc' ? '↑' : '↓' }}{% endif %}
                                        </a>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for list in sortedLists %}
                                    <tr style="cursor: pointer;" onclick="window.location='{{ path('app_list_show', {id: list.id, slug: list.slug}) }}'">
                                        <td>
                                            <div class="position-relative" style="width: 85px; height: 60px; transform: rotate(-2deg);">
                                                {% for previewItem in list.previewItems(3) %}
                                                    {% set offsetLeft = (loop.index0 * 15) %}
                                                    {% set offsetTop = (loop.index0 * 4) %}
                                                    {% set zIndex = 10 - loop.index0 %}
                                                    {% if previewItem.album.imageUrl %}
                                                        <img src="{{ album_cover_base_url ~ previewItem.album.imageUrl }}" 
                                                                alt="{{ previewItem.album.title }}" 
                                                                class="img-thumbnail position-absolute" 
                                                                style="width: 50px; height: 50px; object-fit: cover; top: {{ offsetTop }}px; left: {{ offsetLeft }}px; z-index: {{ zIndex }};"
                                                                title="{{ previewItem.album.title }} - {{ previewItem.album.artistNames }}">
                                                    {% else %}
                                                        <div class="bg-light border d-flex align-items-center justify-content-center text-muted small text-center p-1 position-absolute" 
                                                                style="width: 50px; height: 50px; font-size: 0.6rem; top: {{ offsetTop }}px; left: {{ offsetLeft }}px; z-index: {{ zIndex }};"
                                                                title="{{ previewItem.album.title }} - {{ previewItem.album.artistNames }}">
                                                            No Img
                                                        </div>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        </td>
                                        <td>
                                            <a href="{{ path('app_list_show', {id: list.id, slug: list.slug}) }}" class="text-decoration-none fw-bold">{{ list.title }}</a>
                                            {% if list.aggregatedIn|length > 0 %}
                                                <br>
                                                <small class="text-muted">
                                                    Part of: 
                                                    {% for aggList in list.aggregatedIn %}
                                                        <a href="{{ path('app_list_show', {id: aggList.id, slug: aggList.slug}) }}" class="text-muted text-decoration-underline">{{ aggList.title }}</a>{% if not loop.last %}, {% endif %}
                                                    {% endfor %}
                                                </small>
                                            {% endif %}
                                            <br>
                                            <small class="text-muted">
                                                {{ list.releaseYear }}
                                            </small>
                                        </td>
                                        <td>
                                             <span class="badge bg-light text-dark border">
                                                {% if list.type == 'ordered' %}
                                                    Genummerd
                                                {% elseif list.type == 'unordered' %}
                                                    Ongenummerd
                                                {% elseif list.type == 'aggregate' %}
                                                    Verzamelijst
                                                {% else %}
                                                    {{ list.type|capitalize }}
                                                {% endif %}
                                             </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted">Geen lijsten gevonden voor deze recensent.</p>
                {% endif %}
            </div>

            <div id="reviews" class="mt-5">
                <h3>Recensies</h3>
                {% if sortedReviews is not empty %}
                    <div class="table-responsive">
                        <table class="table table-striped align-middle">
                            <thead>
                                <tr>
                                    <th style="width: 80px;">Cover</th>
                                    <th>
                                        {% set next_dir = (reviewSort == 'album' and reviewDir == 'asc') ? 'desc' : 'asc' %}
                                        <a href="{{ path('app_critic_show', base_params|merge({'review_sort': 'album', 'review_dir': next_dir})) }}#reviews" class="text-dark text-decoration-none">
                                            Album
                                            {% if reviewSort == 'album' %}{{ reviewDir == 'asc' ? '↑' : '↓' }}{% endif %}
                                        </a>
                                    </th>
                                    <th>
                                        {% set next_dir = (reviewSort == 'rating' and reviewDir == 'asc') ? 'desc' : 'asc' %}
                                        <a href="{{ path('app_critic_show', base_params|merge({'review_sort': 'rating', 'review_dir': next_dir})) }}#reviews" class="text-dark text-decoration-none">
                                            Rating
                                            {% if reviewSort == 'rating' %}{{ reviewDir == 'asc' ? '↑' : '↓' }}{% endif %}
                                        </a>
                                    </th>
                                    <th>
                                        {% set next_dir = (reviewSort == 'magazine' and reviewDir == 'asc') ? 'desc' : 'asc' %}
                                        <a href="{{ path('app_critic_show', base_params|merge({'review_sort': 'magazine', 'review_dir': next_dir})) }}#reviews" class="text-dark text-decoration-none">
                                            Magazine
                                            {% if reviewSort == 'magazine' %}{{ reviewDir == 'asc' ? '↑' : '↓' }}{% endif %}
                                        </a>
                                    </th>
                                    <th>
                                        {% set next_dir = (reviewSort == 'year' and reviewDir == 'asc') ? 'desc' : 'asc' %}
                                        <a href="{{ path('app_critic_show', base_params|merge({'review_sort': 'year', 'review_dir': next_dir})) }}#reviews" class="text-dark text-decoration-none">
                                            Jaar
                                            {% if reviewSort == 'year' %}{{ reviewDir == 'asc' ? '↑' : '↓' }}{% endif %}
                                        </a>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for review in sortedReviews %}
                                    <tr>
                                        <td>
                                            {% if review.album.imageUrl %}
                                                <img src="{{ album_cover_base_url ~ review.album.imageUrl }}" alt="{{ review.album.title }}" class="img-fluid rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                            {% else %}
                                                <div class="bg-light border rounded d-flex align-items-center justify-content-center text-muted small" style="width: 50px; height: 50px; font-size: 0.6rem;">No Img</div>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('app_album_show', {id: review.album.id}) }}" class="text-decoration-none fw-bold">{{ review.album.title }}</a>
                                            <br>
                                            <small class="text-muted">
                                                {% for albumArtist in review.album.albumArtists %}
                                                    <a href="{{ path('app_artist_show', albumArtist.artist.routeParams) }}" class="text-muted">{{ albumArtist.artist.name }}</a>{% if not loop.last %}, {% endif %}
                                                {% endfor %}
                                            </small>
                                        </td>
                                        <td>
                                            {{ rating_macros.render(review) }}
                                        </td>
                                        <td>
                                            {% if review.magazine %}
                                                {{ review.magazine.name }}
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if review.year %}
                                                {{ review.year }}
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <p class="text-muted">Geen recensies gevonden voor deze recensent.</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<div id="sticky-header" class="fixed-top bg-white border-bottom shadow-sm py-2" style="transform: translateY(-100%); transition: transform 0.3s ease-in-out; z-index: 1050;">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center text-truncate">
                <a href="{{ path('app_home') }}" class="btn btn-sm btn-outline-secondary me-3">Home</a>
                <div class="text-truncate">
                    <div class="fw-bold text-truncate">{{ critic.name }}</div>
                    <small class="text-muted">Recensent</small>
                </div>
            </div>
            <div class="flex-shrink-0 ms-3">
                 <a href="#" class="btn btn-sm btn-outline-info me-2">Metadata</a>
                 <a href="#lists" class="btn btn-sm btn-outline-primary me-2">
                    Lijsten <span class="badge bg-primary text-white ms-1">{{ critic.albumLists|length }}</span>
                 </a>
                 <a href="#reviews" class="btn btn-sm btn-outline-secondary">
                    Recensies <span class="badge bg-secondary text-white ms-1">{{ critic.reviews|length }}</span>
                 </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var stickyHeader = document.getElementById('sticky-header');
        var threshold = 300;

        window.addEventListener('scroll', function() {
            if (window.scrollY > threshold) {
                stickyHeader.style.transform = 'translateY(0)';
            } else {
                stickyHeader.style.transform = 'translateY(-100%)';
            }
        });
    });
</script>
{% endblock %}
