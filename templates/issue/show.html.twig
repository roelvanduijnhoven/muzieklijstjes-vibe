{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
        <li class="breadcrumb-item"><a href="{{ path('app_magazine_show', issue.magazine.routeParams) }}">{{ issue.magazine.name }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">#{{ issue.issueNumber }} ({{ issue.year }})</li>
      </ol>
    </nav>

    <h1>{{ issue.magazine.name }} - #{{ issue.issueNumber }}</h1>
    <p class="lead">Published in {{ issue.year }}</p>

    <h3>Reviews</h3>
    {% if issue.reviews is not empty %}
        {% include 'review/_table.html.twig' with {
            reviews: issue.reviews,
            columns: ['artist', 'album', 'critic', 'rubric', 'rating', 'source'],
            table_classes: 'table-striped align-middle'
        } %}
    {% else %}
        <p>No reviews found for this issue.</p>
    {% endif %}
</div>
{% endblock %}
