{% extends 'base.html.twig' %}
{% import 'macros/list_macros.html.twig' as macros %}

{% block body %}
<div class="container mt-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ magazine.name }}</li>
      </ol>
    </nav>

    <h1>{{ magazine.name }}</h1>

    <p class="mb-4">
        <a href="#issues" class="btn btn-sm btn-outline-secondary">
            Naar uitgaves <span class="badge bg-secondary text-white ms-1">{{ magazine.issues|length }}</span>
        </a>
    </p>

    <div class="row mt-4" id="lists">
        <div class="col-12">
            <h3>Lijsten</h3>
            <p class="text-muted">Alle lijsten gerelateerd aan deze bron.</p>
            {% if magazine.albumLists is not empty %}
                <div class="list-group mb-4">
                    {% for list in magazine.albumLists %}
                        {{ macros.list_card(list, album_cover_base_url) }}
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-muted">Geen lijsten gevonden.</p>
            {% endif %}
        </div>
    </div>

    <div class="row mt-4" id="issues">
        <div class="col-12">
            <h3>Uitgaves</h3>
            <p class="text-muted">Overzicht van alle uitgaves per jaar.</p>
            {% if groupedIssues is defined and groupedIssues is not empty %}
                {% for year, issues in groupedIssues %}
                    <h5 class="mt-3">{{ year }}</h5>
                    <div class="list-group list-group-horizontal flex-wrap mb-3">
                        {% for issue in issues %}
                            <a href="{{ path('app_issue_show', {id: issue.id}) }}" class="list-group-item list-group-item-action text-center" style="width: auto; min-width: 60px;">
                                #{{ issue.issueNumber }}
                            </a>
                        {% endfor %}
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-muted">Geen uitgaves gevonden.</p>
            {% endif %}
        </div>
    </div>
</div>

<div id="sticky-header" class="fixed-top bg-white border-bottom shadow-sm py-2" style="transform: translateY(-100%); transition: transform 0.3s ease-in-out; z-index: 1050;">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center text-truncate">
                <a href="{{ path('app_home') }}" class="btn btn-sm btn-outline-secondary me-3">Home</a>
                <div class="text-truncate">
                    <div class="fw-bold text-truncate">{{ magazine.name }}</div>
                    <small class="text-muted">Magazine</small>
                </div>
            </div>
            <div class="flex-shrink-0 ms-3">
                 <a href="#lists" class="btn btn-sm btn-outline-primary me-2">
                    Lijsten <span class="badge bg-primary text-white ms-1">{{ magazine.albumLists|length }}</span>
                 </a>
                 <a href="#issues" class="btn btn-sm btn-outline-secondary">
                    Uitgaves <span class="badge bg-secondary text-white ms-1">{{ magazine.issues|length }}</span>
                 </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var stickyHeader = document.getElementById('sticky-header');
        var threshold = 300;

        window.addEventListener('scroll', function() {
            if (window.scrollY > threshold) {
                stickyHeader.style.transform = 'translateY(0)';
            } else {
                stickyHeader.style.transform = 'translateY(-100%)';
            }
        });
    });
</script>
{% endblock %}
